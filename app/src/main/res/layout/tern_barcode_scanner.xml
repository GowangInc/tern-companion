<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberate replacement for the library's default barcode view content,
     selected with app:zxing_scanner_layout on the DecoratedBarcodeView tag in
     tern_pairing_capture.xml. The ids below are exactly the ones
     DecoratedBarcodeView looks up; the custom viewfinder only changes drawing,
     never decoding. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <com.journeyapps.barcodescanner.BarcodeView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/zxing_barcode_surface"/>

    <io.github.gowanginc.terncompanion.LineworkViewfinder
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/zxing_viewfinder_view"/>

    <TextView
        android:id="@+id/zxing_status_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:visibility="gone"
        android:textColor="@color/tern_ivory"/>
</merge>
